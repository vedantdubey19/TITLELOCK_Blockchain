# Template only: provide actual values through your host's secret manager or an
# ignored chmod-600 environment file. The app reads .env by default; host env wins.
# Keep frontend and /api on the same HTTPS origin for existing cookie sessions.
APP_ENV=production
SECRET_KEY=
SALE_TOKEN_SECRET=
# Blank disables public registrar signup; approval still requires operator review.
REGISTRAR_SIGNUP_CODE=
# Replace the example hostname consistently; never use '*' or local demo origins.
TRUSTED_HOSTS=["titlelock.example.com"]
FRONTEND_ORIGINS=["https://titlelock.example.com"]
# Dedicated non-admin DB role, no demo/test data. Supply provider's CA certificate
# via sslrootcert, or sslrootcert=system where supported by the hosting runtime.
DATABASE_URL=
# Example shape: postgresql://APP_USER:PASSWORD@DB_HOST/TITLELOCK?sslmode=verify-full&sslrootcert=/run/secrets/database-ca.pem
SESSION_TTL_HOURS=24
LOGIN_OTP_ENABLED=false
OTP_TEST_RECIPIENT_EMAIL=
CHAIN_MODE=live
CHAIN_ID=11155111
CHAIN_RPC_URL=
CHAIN_LOGS_RPC_URL=
CHAIN_LOG_BLOCK_RANGE=10000
CHAIN_CONTRACT_ADDRESS=0xADbAdFEE8843a5A1c50785B0788c3aeA1CF95362
CHAIN_DEPLOYMENT_BLOCK=11954043
CHAIN_CONFIRMATIONS=3
# Service wallet used only after the two-key approval. Store in Render's secret manager.
CHAIN_SERVICE_PRIVATE_KEY=
