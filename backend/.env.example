# Copy to .env and fill in. .env is git-ignored — never commit secrets.

# development | testing | production
APP_ENV=development

# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase Postgres connection string (Supabase → Connect). URL-encode special
# characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=

# Bearer sessions expire after this many hours (1–168).
SESSION_TTL_HOURS=24
# Empty disables registrar signup. Use a private random value, never the UI demo code.
REGISTRAR_SIGNUP_CODE=
# Origins permitted to submit browser authentication requests (JSON array).
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# mock = in-memory chain | live = web3.py against CHAIN_RPC_URL (local Hardhat or Amoy)
CHAIN_MODE=mock
CHAIN_RPC_URL=http://127.0.0.1:8545

# Login OTP delivery: Twilio SMS + Resend email. Server-only credentials.
# Keep false until provider configuration and OTP integration are tested.
LOGIN_OTP_ENABLED=false
# Twilio Console → Account SID (starts with AC).
TWILIO_ACCOUNT_SID=
# Twilio Console → Auth Token. Keep private.
TWILIO_AUTH_TOKEN=
# SMS-enabled Twilio sender in international format, e.g. +1xxxxxxxxxx.
TWILIO_FROM_NUMBER=
# Resend → API Keys → Create API Key (starts with re_).
RESEND_API_KEY=
# Verified sender, e.g. TitleLock <otp@your-verified-domain.com>.
OTP_EMAIL_FROM=

# Twilio Verify → Services → TitleLock → Service SID (starts with VA).
TWILIO_VERIFY_SERVICE_SID=

# Development only: email used to register with Resend (required for onboarding@resend.dev).
OTP_TEST_RECIPIENT_EMAIL=

# Independent secret for keyed sell-token fingerprints. Generate a random 32+ byte value.
SALE_TOKEN_SECRET=
